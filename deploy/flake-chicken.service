[Unit]
Description=Flake Chicken API
After=network.target

[Service]
ExecStart=/opt/flake-chicken/server
Environment=LISTEN_ADDR=:8080
DynamicUser=yes
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
MemoryMax=128M

[Install]
WantedBy=multi-user.target
