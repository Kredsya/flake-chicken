[Unit]
Description=Flake Chicken API
After=network.target

[Service]
ExecStart=/opt/flake-chicken/server
Environment=LISTEN_ADDR=127.0.0.1:8080
EnvironmentFile=/etc/flake-chicken/server.env
Environment=GOMEMLIMIT=96MiB
StateDirectory=flake-chicken
StateDirectoryMode=0700
Environment=WEB_DIR=/opt/flake-chicken/web
DynamicUser=yes
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
MemoryMax=192M

[Install]
WantedBy=multi-user.target
